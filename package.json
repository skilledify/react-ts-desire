{
  "name": "react-ts-desire",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Desire — furniture website. Vite + React 19 + TypeScript + React Router 7",
  "homepage": "https://skilledify.github.io/react-ts-desire",
  "author": "skilledify",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist",
    "smoke": "vite build --config vite.smoke.config.ts && node scripts/smoke.mjs"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router": "^7.9.0",
    "swiper": "^11.2.10"
  },
  "devDependencies": {
    "@types/node": "^24.19.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "jsdom": "^26.1.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  }
}
